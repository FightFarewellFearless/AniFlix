{
  "name": "aniflix-windows",
  "productName": "AniFlix",
  "version": "2.2.0-LTS",
  "description": "AniFlix - Anime streaming application for Windows",
  "main": "dist/main.js",
  "author": "AniFlix Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:8081 && electron .\"",
    "build-main": "tsc -p tsconfig.json",
    "build-renderer": "vite build",
    "build": "yarn build-main && yarn build-renderer && electron-builder",
    "publish": "electron-builder --publish always",
    "generate-icons": "python scripts/generate-icons.py"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "better-sqlite3": "^11.0.0",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.23.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
